{
  "name": "homebridge-ratgdo",
  "displayName": "Ratgdo",
  "version": "3.0.0",
  "description": "HomeKit integration using Ratgdo and Konnected devices for LiftMaster and Chamberlain garage door openers, without requiring myQ.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git://github.com/hjdhjd/homebridge-ratgdo.git"
  },
  "bugs": {
    "url": "https://github.com/hjdhjd/homebridge-ratgdo/issues"
  },
  "type": "module",
  "engines": {
    "homebridge": ">=1.8.0 || >=2.0.0",
    "node": ">=22.20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build-docs": "npm run build && homebridge-plugin-utils prepare-docs dist/options.js && homebridge-plugin-utils prepare-chrome docChrome.json",
    "build-ui": "homebridge-plugin-utils prepare-ui homebridge-ui/public/lib",
    "clean": "node -e \"for(const p of ['dist','homebridge-ui/public/lib'])require('node:fs').rmSync(p,{force:true,recursive:true})\"",
    "lint": "eslint --max-warnings=${ESLINT_MAX_WARNINGS:-\"-1\"} eslint.config.mjs src homebridge-ui/*.js homebridge-ui/public/ui.mjs",
    "postpublish": "npm run clean",
    "prebuild": "npm run clean && npm run build-ui",
    "prelint": "npm run build-ui",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-exclude=\"src/**/*.helpers.ts\" --test-coverage-exclude=\"src/platform.ts\" --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=85 --test-timeout=15000 \"src/**/*.test.ts\"",
    "test:watch": "node --test --watch \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "chamberlain",
    "esphome",
    "homebridge-plugin",
    "homekit",
    "garage",
    "garage door opener",
    "gdo",
    "liftmaster",
    "konnected",
    "myq",
    "ratgdo"
  ],
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.1.1",
    "eslint": "9.39.2",
    "homebridge": "2.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.5",
    "bonjour-service": "1.3.0",
    "esphome-client": "2.0.0",
    "homebridge-plugin-utils": "2.1.0"
  },
  "overrides": {
    "@types/readable-stream": "4.0.23"
  }
}
